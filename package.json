{
  "name": "@codewithrajat/rm-toast-notification",
  "version": "1.0.0",
  "description": "A lightweight, customizable, and dependency-free toast notification service for web applications. Display timed notifications with auto-dismiss, animations, and multiple styles. Works with React, Angular, Vue, Svelte, and vanilla JavaScript. Zero-config setup, framework-agnostic, and fully typed with TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node copy-extra-files.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "prepack": "npm run build"
  },
